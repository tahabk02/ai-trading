# =============================================================================
#  ALPHA.5 PRO — PRODUCTION ENVIRONMENT FILE
# =============================================================================
#  Copy to `.env` at the repository root and fill in every value marked REQUIRED:
#
#      cp .env.production.example .env
#      # generate the secrets (never reuse dev values):
#      openssl rand -base64 48     # JWT_SECRET, AI_ENGINE_API_KEY
#      openssl rand -base64 24     # DB_PASSWORD
#      openssl rand -base64 32     # REDIS_PASSWORD
#
#  ── WHO READS THIS FILE ────────────────────────────────────────────────────
#  The services themselves do NOT read this root file — each one reads its own
#  directory env (core-backend/.env.prod, ai-engine/.env, pocket-bridge/.env).
#  This root `.env` is consumed by `docker compose -f docker-compose.prod.yml`
#  for `${VAR}` interpolation and for the values compose injects into the
#  containers. See .env.example for the full who-reads-what map.
#
#  The compose file guards the critical values with `${VAR:?…}`, so a missing
#  secret is a PARSE-TIME failure with a named error — never a container that
#  boots with a guessable default.
#
#  ⚠️  NEVER commit the real `.env`. Only this `*.example` template is tracked.
#
#  ───────────────────────────────────────────────────────────────────────────
#  NON-FABRICATION GATES — DO NOT ADD KILL-SWITCH / FORCE-OVERRIDE FLAGS
#  ───────────────────────────────────────────────────────────────────────────
#  This platform tells the HONEST truth about a setup: when confluence is too
#  low, an instrument has too few ticks, or the market is closed, that is the
#  answer the UI shows. The former `GLOBAL_FORCE_OVERRIDE` escape hatch was
#  REMOVED and is pinned by ai-engine/tests/test_no_force_emit_escape.py, which
#  fails if it is reintroduced under ANY name. The gate constants
#  (OTC_HF_PASS_BAR, MIN_OTC_TICKS, MIN_REAL_CLOSES, the T1 confidence bar) are
#  deliberately NOT environment-tunable for a hosted deploy. If you find
#  yourself adding a variable to "make the board show trades", you are
#  fabricating signals — stop. `EXECUTION_DRY_RUN` below defaults to true and
#  must stay true until a reviewed live-execution path exists.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  EDGE / TLS  (nginx `edge` profile + Let's Encrypt)
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname the app is served from. DNS must already point here and
# ports 80 + 443 must be reachable for certificate issuance/renewal.
DOMAIN=trade.example.com

# Contact address for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=ops@example.com

# ─────────────────────────────────────────────────────────────────────────────
#  POSTGRES  (compose service `postgres`; NOT published to the host)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — no default is applied to the password on purpose.
#   openssl rand -base64 24
DB_USER=postgres
DB_PASSWORD=
DB_NAME=trading_radar

# ─────────────────────────────────────────────────────────────────────────────
#  REDIS  (compose service `redis`; password REQUIRED, not published)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Without it Redis boots with no auth (and the healthcheck fails).
#   openssl rand -base64 32
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
#  AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. core-backend REFUSES TO BOOT when this is unset, a known
# placeholder, or < 32 chars — a weak signing key makes every token forgeable.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# REQUIRED. Shared service-to-service key; MUST match on core-backend AND
# ai-engine (both refuse to boot without it).
#   openssl rand -base64 48
AI_ENGINE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  CORS  — the REAL public origin, never `*`
# ─────────────────────────────────────────────────────────────────────────────
# The browser is same-origin behind nginx, so this must be the public URL.
# `Access-Control-Allow-Origin: *` is illegal with `credentials: true`.
# Multiple origins may be comma-separated (e.g. apex + www).
CORS_ORIGIN=https://trade.example.com

# ─────────────────────────────────────────────────────────────────────────────
#  AI ENGINE TUNING
# ─────────────────────────────────────────────────────────────────────────────

# Structural confidence bar for an ACTIVE signal (0–1). Raising/lowering this
# is a legitimate tuning knob; it is NOT a fabrication override.
CONFIDENCE_THRESHOLD=0.98

# Interactive ML inference budget (ms). 0 = legacy unbounded behavior.
AI_ENGINE_INFERENCE_BUDGET_MS=150

# ─────────────────────────────────────────────────────────────────────────────
#  EXECUTION  — FAIL-CLOSED dry-run (KEEP TRUE)
# ─────────────────────────────────────────────────────────────────────────────
# true (or UNSET) => dry-run: POST /trades validates + audits but places NO
# order. The live path opens ONLY on an explicit 0|false|no|off. No broker is
# wired in this deployment; leave this at `true`.
EXECUTION_DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
#  RATE LIMITING  (core-backend)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ─────────────────────────────────────────────────────────────────────────────
#  MARKET DATA  (leave empty to degrade honestly — there are no fake fallbacks)
# ─────────────────────────────────────────────────────────────────────────────
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=
ALPACA_USE_SANDBOX=true
ALPACA_BASE_URL=https://data.sandbox.alpaca.markets
ALPACA_WS_ENDPOINT=wss://stream.data.sandbox.alpaca.markets/v2/sip
TWELVE_DATA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  POCKET OPTION LIVE BRIDGE  (real prices only; NEVER fabricates ticks)
# ─────────────────────────────────────────────────────────────────────────────
# Full `42["auth",{...}]` session cookie from a logged-in Pocket Option browser
# session. Empty = clean "awaiting_ssid" state with no live data (honest).
POCKET_OPTION_SSID=
POCKET_OPTION_UID=
POCKET_OPTION_IS_DEMO=0

# ── PO SSID self-healing (opt-in, OFF by default) ───────────────────────────
# Inert unless EVERY gate is set: PO_EMAIL_LOGIN + a credential + PO_TOS_CONSENT.
# Prefer mounted secret FILES over plain env values in production.
PO_EMAIL_LOGIN=false
PO_EMAIL_FILE=
PO_PASSWORD_FILE=
PO_EMAIL=
PO_PASSWORD=
PO_LOGIN_TIMEOUT=45
PO_TOS_CONSENT=
PO_AUTH_NODE_TRIGGER=false
PO_HEALTH_ADMIN_KEY=
PO_HEALTH_HOSTED=true
PO_SESSION_STALE_ALERT_MIN=15
PO_ALERT_EMAIL=
PO_ALERT_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  MARKET DATA PUBLISHER  (optional — GitHub-backed spot feed)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
