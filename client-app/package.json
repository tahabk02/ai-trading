{
  "name": "client-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "clean": "node scripts/clean-build-cache.js",
    "verify": "node scripts/verify-manifest.js",
    "build": "npm run clean && next build && npm run verify",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:logic": "vitest run --project logic",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest --project ui --watch"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.395.0",
    "next": "15.5.27",
    "react": "^19",
    "react-dom": "^19",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
