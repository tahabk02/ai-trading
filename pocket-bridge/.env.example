# =============================================================================
# POCKET OPTION LIVE DATA BRIDGE -- ENVIRONMENT VARIABLES
# =============================================================================
# Standalone Python service that connects to the Pocket Option live feed and
# relays real-time ticks + strict M20 (20s) candles to the Node.js backend.
#
# It never fabricates prices. Without a valid SSID the bridge runs in a clean
# "awaiting_ssid" state.
#
# ── WHERE THIS FILE IS LOADED FROM ───────────────────────────────────────────
# `pocket_bridge/config.py` resolves the path from its own location
# (`<repo>/pocket-bridge/.env`), NOT from the process working directory. The
# repository-root `.env` is NEVER read: it belongs to core-backend, and loading
# it here would hand this service another component's configuration.
#
# Precedence, highest first:
#   1. real environment variable (docker compose / CI / systemd)
#   2. pocket-bridge/.env.local        (gitignored developer override)
#   3. pocket-bridge/.env.<ENVIRONMENT>  (only when it exists)
#   4. pocket-bridge/.env
#
# ── SECRETS ──────────────────────────────────────────────────────────────────
# POCKET_OPTION_SSID and PO_SESSION_KEY are real session credentials and this
# file is TRACKED IN GIT. Never write a live value here; keep them in the
# gitignored `pocket-bridge/.env`.
# =============================================================================

# Full Pocket Option session cookie (the whole `42["auth",{...}]` payload that
# BinaryOptionsToolsV2 requires). Obtain it from your logged-in browser:
#   DevTools -> Application -> Cookies -> https://pocketoption.com -> ssid
# Copy the ENTIRE frame exactly; the bridge forwards every key (session,
# isDemo, uid, platform, isFastHistory, isOptimized) to the SDK unchanged.
# Demo capture shape (use your own live token, never commit it):
# POCKET_OPTION_SSID='42["auth",{"session":"<demo-session-token>","isDemo":1,"uid":138336943,"platform":9,"isFastHistory":true,"isOptimized":true}]'
# Leave empty to run the bridge in "awaiting_ssid" mode (no live data).
POCKET_OPTION_SSID=
# PREFERRED: mount the full frame as a file and point here. The file wins over
# POCKET_OPTION_SSID and preserves quotes/backslashes exactly, avoiding
# shell/Compose escaping damage to a PHP-serialized session. Compose mounts
# ./pocket-bridge/secrets at /run/secrets (read-only, gitignored).
# POCKET_OPTION_SSID_FILE=/run/secrets/pocket_option_ssid
# Optional WebSocket User-Agent override. Blank or unset uses the pinned Chrome
# 129 User-Agent. docker-compose forwards the repository-root .env setting.
# POCKET_OPTION_USER_AGENT=

# ── SESSION PERSISTENCE (capture once, reuse automatically) ────────────────
# Captured browser session (see session/README.md). refresh_ssid.py reuses it
# and rotates the SSID into this .env automatically. default: session/po_session.json
# PO_SESSION_PATH=
# How often refresh_ssid.py is re-run (seconds). default: 1800
# PO_SESSION_REFRESH_INTERVAL=1800
# Captured-session age (days) after which it is treated as stale. default: 7
# PO_SESSION_MAX_AGE_DAYS=7
# Refresh at startup (1/0). default: 1
# PO_REFRESH_AT_STARTUP=1
# Optional at-rest encryption key (Fernet, pip install cryptography). When set,
# po_session.json is stored as `FERNET:<base64>` instead of plain JSON.
# PO_SESSION_KEY=

# �"?�"? LAST-RESORT CREDENTIAL LOGIN (opt-in, ban-safe) �"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?
# session/refresh_ssid.py refreshes the SSID from the captured session with NO
# credentials. These are ONLY consulted when that session tier yields no auth
# frame (session dead) AND PO_EMAIL_LOGIN=1 AND both halves are present AND a
# written PO_TOS_CONSENT is recorded. The steady state never touches these.
# Keep real values in the gitignored pocket-bridge/.env — never in this tracked
# example. These values are handed to the refresh_ssid.py child ONLY; the bridge
# and the core-backend never receive them (PART 43.6 [480]).
# Enable the last-resort credential login ("true"/"1"). Default: false (OFF).
# PO_EMAIL_LOGIN=false
# Email + password via a mounted SECRET FILE (Docker secret / read-only volume).
# Preferred in containers; the file wins over the plain env value below
# (PART 43.6 [481]). The value itself never travels in the env.
# PO_EMAIL_FILE=
# PO_PASSWORD_FILE=
# Plain-env fallback for local/dev use only (never commit real values).
# PO_EMAIL=
# PO_PASSWORD=
# Seconds to budget the headless login form. Default: 45.
# PO_LOGIN_TIMEOUT=45
# Recorded acknowledgement of Pocket Option's terms on automated login. Required
# for the credential tier to be usable at all (PART 43.6 [482]) — see
# docs/legal/po-automated-login-tos-consent.md. Default: unset (OFF).
# PO_TOS_CONSENT=

# Local relay the core-backend connects to (WebSocket client).
POCKET_BRIDGE_HOST=127.0.0.1
POCKET_BRIDGE_PORT=8788

# ── Account identity ───────────────────────────────────────────────────────
# Numeric user id, demo flag and platform id. They MUST match the captured
# auth frame; the frame's own fields win when present, these env values are
# only the fallback for raw tokens. Current demo capture: uid=138336943,
# isDemo=1, platform=9. Values default to 0/0/2 when unset.
POCKET_OPTION_UID=138336943
POCKET_OPTION_IS_DEMO=1
POCKET_OPTION_PLATFORM=9

# ── Egress proxy (cloud VPS / Hetzner) ─────────────────────────────────────
# OPTIONAL. Leave PROXY_URL unset/empty to connect DIRECTLY from the host's
# own interface (SERVER_PUBLIC_IP). Set it to route the Pocket Option
# WebSocket through a SOCKS5/HTTP proxy. This changes ONLY the network path:
# no TLS/JA3/cipher settings are touched. Credentials use
# `scheme://user:pass@host:port` and are redacted from logs/health. A malformed
# non-empty value fails fast at startup. Supported: socks5, socks5h, http, https.
# PROXY_URL=socks5://user:password@proxy.example.com:1080
# PROXY_URL=http://10.0.0.5:3128

# Public IP of the host running the bridge. Informational only: it is shown in
# the boot log and /health so egress/proxy routing can be correlated with the
# VPS. It is never injected into the auth payload. Must be a literal IP.
SERVER_PUBLIC_IP=91.99.71.111

# ── Handshake / reconnect tuning ───────────────────────────────────────────
# Seconds to wait for the Pocket Option auth handshake before giving up.
POCKET_OPTION_INIT_TIMEOUT=120
# Exponential reconnect ladder for per-symbol readers: base * 2^attempt,
# capped at max, with randomized jitter (fraction of the delay) to avoid
# reconnect storms. Defaults: base=1s, max=60s, jitter=0.25.
# POCKET_BRIDGE_RECONNECT_BASE_SECS=1
# POCKET_BRIDGE_RECONNECT_MAX_SECS=60
# POCKET_BRIDGE_RECONNECT_JITTER=0.25
# Seconds before retrying a dropped live-feed socket.
POCKET_OPTION_RECONNECT_TIME=3
# Per-request timeout against the Pocket Option API, in seconds.
POCKET_OPTION_TIMEOUT_SECS=30
# Active Socket.IO keepalive/heartbeat interval. Must stay below PO's ~60s
# idle cutoff; 25s also drives the heartbeat frame sent to the Node backend.
POCKET_BRIDGE_HEARTBEAT_INTERVAL=25
# Recycle a connected-but-silent stream after this many seconds (before the
# server's 60s idle timeout). Engine/dynamic OTC subscription state is retained.
POCKET_BRIDGE_STREAM_STALE_SECS=50
# Raw keepalive event sent to Pocket Option on each heartbeat.
POCKET_OPTION_KEEPALIVE_MESSAGE=42["ping"]
# Candle aggregation window relayed to the backend as the SSOT. The backend
# derives every other timeframe from these strict buckets, so changing this
# changes the authoritative feed shape. default: 20s
POCKET_BRIDGE_CANDLE_TIMEFRAME=20s
# Platform clock offset in seconds, used to align candle boundaries with the
# exchange's own clock rather than the local host's. default: 7200
POCKET_BRIDGE_TIME_OFFSET=7200

# Optional: fallback Pocket Option WebSocket server URLs (comma-separated).
# POCKET_OPTION_WS_URLS=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Selects the `.env.<ENVIRONMENT>` file, so keep it to a short token like
# development / staging / production.
# ENVIRONMENT=development
