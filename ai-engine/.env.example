# ═══════════════════════════════════════════════════════════════════════════
# AI ENGINE — ENVIRONMENT TEMPLATE (secret-free, copy to `.env`)
# ═══════════════════════════════════════════════════════════════════════════
# PRIMARY FEED: Pocket Option OTC live WebSocket tape via `pocket-bridge`.
# Alpaca is ISOLATED + DISABLED by default — never ship live keys here.

# --- Alpaca: DISABLED (keep blank) ---
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_PAPER=true
ALPACA_USE_SANDBOX=true

# --- Standard SDK Overrides (Alt Names) — DISABLED (keep blank) ---
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""
APCA_API_BASE_URL="https://paper-api.alpaca.markets"
APCA_PAPER=true

# --- Core Backend: active service the engine reports signals INTO ---
# POST {BACKEND_API_URL}/signals/receive (Redis Pub/Sub is tried first).
# Local dev:  http://localhost:4000/api/v1
# Production: http://91.99.71.111:4000/api/v1  (or the real prod host)
# Docker:     http://core-backend:4000/api/v1
BACKEND_API_URL="http://localhost:4000/api/v1"

# --- Optional Redis pub/sub ---
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_URL="redis://localhost:6379/0"

# --- Logging / environment ---
# LOG_FORMAT="CONSOLE"          # "JSON" for production
# ENVIRONMENT="development"