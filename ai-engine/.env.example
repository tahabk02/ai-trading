# ═══════════════════════════════════════════════════════════════════════════
# AI ENGINE — ENVIRONMENT TEMPLATE (secret-free, copy to `.env`)
# ═══════════════════════════════════════════════════════════════════════════
# PRIMARY FEED: Pocket Option OTC live WebSocket tape via `pocket-bridge`.
# Alpaca is ISOLATED + DISABLED by default — never ship live keys here.
#
# ── WHERE THIS FILE IS LOADED FROM ───────────────────────────────────────────
# `app/core/config.py` resolves the path from its own location
# (`<repo>/ai-engine/.env`), NOT from the process working directory. The
# repository-root `.env` is NEVER read: it belongs to core-backend, and loading
# it here silently reconfigured the engine with another service's credentials.
# Starting the engine from any directory now resolves the same files.
#
# Precedence, highest first:
#   1. real environment variable (docker compose / CI / systemd)
#   2. ai-engine/.env.local          (gitignored developer override)
#   3. ai-engine/.env.<ENVIRONMENT>  (only when it exists)
#   4. ai-engine/.env
#
# ── SECRETS ──────────────────────────────────────────────────────────────────
# Every credential below is a PLACEHOLDER and this file is TRACKED IN GIT. Never
# write a live value here. AI_ENGINE_API_KEY must match core-backend's value and
# is a real service credential.

# --- Alpaca: DISABLED (keep blank) ---
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_PAPER=true
ALPACA_USE_SANDBOX=true

# --- Standard SDK Overrides (Alt Names) — DISABLED (keep blank) ---
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""
APCA_API_BASE_URL="https://paper-api.alpaca.markets"
APCA_PAPER=true

# --- Service identity / API surface ---
PROJECT_NAME="AI Engine"
API_V1_STR="/api/v1"
# Name reported in logs and health output. Also selects the `.env.<ENVIRONMENT>`
# file, so keep it to a short token like development / staging / production.
ENVIRONMENT="development"
LOG_FORMAT="CONSOLE"          # "JSON" for production

# --- Core Backend: active service the engine reports signals INTO ---
# POST {BACKEND_API_URL}/signals/receive (Redis Pub/Sub is tried first).
# Local dev:  http://localhost:4000/api/v1
# Docker:     http://core-backend:4000/api/v1
# Production: the real prod host, injected via the environment — never commit it
BACKEND_API_URL="http://localhost:4000/api/v1"

# --- Service-to-service credential ---
# MUST match core-backend's AI_ENGINE_API_KEY. Required in production: a public
# constant authenticates nothing, since anyone reading the repo would know it.
AI_ENGINE_API_KEY="change-me-internal-service-key"

# --- CORS: browser origins allowed to call the engine with credentials ---
# Comma-separated. NEVER use "*" here: combined with credentials it is the one
# pairing the Fetch spec forbids, and Starlette "fixes" it by reflecting
# whatever origin asked -- i.e. any website a logged-in operator visits could
# drive the trading engine. An unlisted origin is rejected.
#
# Add real hostnames explicitly, e.g.:
# CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://trading.example.com"
#
# Usually unnecessary: the browser reaches the engine same-origin through the
# Next.js "/ai/:path*" rewrite, so CORS is only exercised by direct calls.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Also reflect any https://*.devtunnels.ms and *.tunnels.api.visualstudio.com
# origin, so a reissued tunnel needs no config edit. https only.
CORS_ALLOW_DEV_TUNNELS=true

# --- Redis pub/sub (optional locally) ---
REDIS_HOST="localhost"
REDIS_PORT=6379
# Required once Redis runs with `requirepass` (the hardened production stack
# does) — without it every connect fails NOAUTH.
REDIS_PASSWORD=""
# Full URL takes precedence over the parts above when set.
REDIS_URL=""

# --- Signal gating ---
# Minimum confidence (0-1) a prediction must reach before it can be emitted.
# Kept at the strict high-precision bar; the validator in signal_gatekeeper
# never lets a configured value fall below MIN_EXECUTABLE_CONFIDENCE_PCT.
CONFIDENCE_THRESHOLD=0.965
# There is deliberately no GLOBAL_FORCE_OVERRIDE knob here. It bypassed the
# gate entirely and could only fabricate tradability, so it was removed rather
# than shipped disabled.

# --- Quote resilience ---
# REAL-market quote resilience. "1" (ENABLED) = a REAL pair with no L2
# bid/ask may use the approved Spread/ATR + flow + MTF proxy validator
# (bar_source="real_proxy_floor") rather than being permanently vetoed.
# This is a labelled SYNTHETIC proxy, NOT genuine L2. "0" = strict veto.
AI_ENGINE_REAL_QUOTE_PROXY=1
