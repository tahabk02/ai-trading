# ═══════════════════════════════════════════════════════════════════════════
# core-backend — example configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy to `core-backend/.env` for local development. That file is gitignored.
#
# ── WHERE THIS FILE IS LOADED FROM ───────────────────────────────────────────
# `src/config/env.ts` resolves the path from its own location
# (`<repo>/core-backend/.env`), NOT from the process working directory. The
# repository-root `.env` is NEVER read: it belongs to the dev-tooling layer, and
# because dotenv is first-wins it previously overrode this service's own
# DATABASE_URL with a local SQLite value. Starting this service from any
# directory now resolves the same files.
#
# Precedence, highest first:
#   1. real environment variable (docker compose / CI / systemd)
#   2. core-backend/.env.local         (gitignored developer override)
#   3. core-backend/.env.<NODE_ENV>    (only when it exists)
#   4. core-backend/.env
#
# ── SECRETS ──────────────────────────────────────────────────────────────────
# Every credential below is a PLACEHOLDER and this file is TRACKED IN GIT. Never
# write a live value here. JWT_SECRET, AI_ENGINE_API_KEY and the Alpaca pair are
# real: inject them from your secret store in production, rotate any value that
# has ever been committed, and keep them only in the gitignored .env.

# ═══════════════════════════════════════════════════════════════════════════
# SERVER & DATABASE SETTINGS
# ═══════════════════════════════════════════════════════════════════════════
PORT=4000
NODE_ENV=development
# Production and tests REQUIRE a real PostgreSQL URL — boot fails fast on a
# missing, placeholder, or `file:` value, because SQLite silently accepts an
# empty schema and the service would look healthy while serving no data.
# Local Docker: postgresql://trading:password@localhost:5433/trading_radar?schema=public
DATABASE_URL="postgresql://trading:password@localhost:5433/trading_radar?schema=public"
CORS_ORIGIN=*

# ── JWT Authentication ────────────────────────────────────────────────────
# Required in production: boot FAILS if unset, a known placeholder, or < 32
# chars. Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=24h

# ── Redis Configuration ───────────────────────────────────────────────────
REDIS_URL=""
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# ── ALPACA SANDBOX / PAPER TRADING CONFIGURATION ──────────────────────────
# ⚠️  NEVER commit real credentials here. This file is tracked in git and is
# baked into the Docker build context. A previous revision of this file (and of
# src/config/secrets.ts) contained a live Alpaca key pair — treat it as
# compromised and REVOKE it in the Alpaca console. Generate a fresh pair and
# put it in the git-ignored core-backend/.env, never in this example file.
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET=""
ALPACA_USE_SANDBOX=true

# Sandbox Market Data Endpoints
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
DATA_PROXY_URL="https://data.sandbox.alpaca.markets"
ALPACA_REST_ENDPOINT="https://data.sandbox.alpaca.markets"
ALPACA_WS_ENDPOINT="wss://stream.data.sandbox.alpaca.markets/v2/sip"

# ── STANDARD ALPACA SDK OVERRIDES (Official SDK env vars) ─────────────────
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""
APCA_API_BASE_URL="https://paper-api.alpaca.markets"
APCA_PAPER=true

# ── AI Engine & WebSockets ────────────────────────────────────────────────
# Use Docker service name (ai-engine) for inter-container communication
# For local development without Docker, use http://localhost:8000
AI_ENGINE_URL="http://ai-engine:8000"
# Service-to-service credential presented to ai-engine; it MUST match the key
# ai-engine validates. Required in production — a public constant here would
# authenticate nothing, since anyone reading the repo would know it.
AI_ENGINE_API_KEY="change-me-internal-service-key"
WS_PATH="/ws"

# ── Pocket Option live bridge ─────────────────────────────────────────────
# The full `42["auth",{...}]` session cookie the Python pocket-bridge uses to
# subscribe to live ticks. When empty the bridge and backend stay in a clean
# "awaiting_ssid" state with NO fabricated prices. Treat it as a session
# credential: it grants account access and belongs only in the gitignored .env.
POCKET_OPTION_SSID=""
POCKET_OPTION_UID=""
# Whether the connected Pocket Option account is a demo account. Affects only
# the bridge's own handshake; the backend never fabricates prices either way.
POCKET_OPTION_IS_DEMO=true
POCKET_BRIDGE_HOST=127.0.0.1
POCKET_BRIDGE_PORT=8788
POCKET_BRIDGE_RECONNECT_MS=5000
POCKET_BRIDGE_AUTO_SPAWN=true

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Spot-Rate Fallback Pipeline ───────────────────────────────────────────
# Budget for the primary HTTP tier (Yahoo intraday, GitHub repo poll).
FOREX_HTTP_TIMEOUT_MS=5000
# Budget PER fallback tier (Frankfurter / open.er-api / CoinGecko). Kept well
# below the 1s tick-ingestion poll interval budget so an outage degrades the
# feed instead of starving the loop. Raise only on a slow egress proxy.
FOREX_FALLBACK_TIMEOUT_MS=2000
# Circuit breaker: skip a tier (no socket, no timeout wait) after N consecutive
# failures for the cooldown window, then re-probe so it self-heals.
FOREX_SOURCE_COOLDOWN_FAILURES=3
FOREX_SOURCE_COOLDOWN_MS=15000
# Emit the fallback-chain audit log at most once per this window per symbol
# (first occurrence of an incident is always logged).
FOREX_CHAIN_AUDIT_LOG_INTERVAL_MS=30000

# ── Misc ───────────────────────────────────────────────────────────────────
# Paper-trading mode for the Alpaca client (informational; the endpoint URLs
# above are the authoritative switch).
ALPACA_PAPER=true
# Force the process timezone so candle bucketing and session boundaries do not
# depend on the host's local settings.
TZ=UTC