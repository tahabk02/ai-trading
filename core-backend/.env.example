# ═══════════════════════════════════════════════════════════════════════════
# SERVER & DATABASE SETTINGS
# ═══════════════════════════════════════════════════════════════════════════
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=*

# ── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET="dev-secret-key-change-in-production-min-32-chars!!"
JWT_EXPIRES_IN=24h

# ── Redis Configuration ───────────────────────────────────────────────────
REDIS_URL=""
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# ── ALPACA SANDBOX / PAPER TRADING CONFIGURATION ──────────────────────────
ALPACA_API_KEY_ID="PKL6YUN6G3B1KK4Q9I7V"
ALPACA_API_SECRET="vfZp7qRx9Mc3K2W4L9b8X7z1N5m0PqRsTuVwXyZa"
ALPACA_USE_SANDBOX=true

# Sandbox Market Data Endpoints
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
DATA_PROXY_URL="https://data.sandbox.alpaca.markets"
ALPACA_REST_ENDPOINT="https://data.sandbox.alpaca.markets"
ALPACA_WS_ENDPOINT="wss://stream.data.sandbox.alpaca.markets/v2/sip"

# ── STANDARD ALPACA SDK OVERRIDES (Official SDK env vars) ─────────────────
APCA_API_KEY_ID="PKL6YUN6G3B1KK4Q9I7V"
APCA_API_SECRET_KEY="vfZp7qRx9Mc3K2W4L9b8X7z1N5m0PqRsTuVwXyZa"
APCA_API_BASE_URL="https://paper-api.alpaca.markets"
APCA_PAPER=true

# ── AI Engine & WebSockets ────────────────────────────────────────────────
# Use Docker service name (ai-engine) for inter-container communication
# For local development without Docker, use http://localhost:8000
AI_ENGINE_URL="http://ai-engine:8000"
AI_ENGINE_API_KEY="INTERNAL_SECRET_AI_ENGINE"
WS_PATH="/ws"

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120