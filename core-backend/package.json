{
  "name": "core-backend",
  "version": "1.0.0",
  "description": "Trading AI Platform - Core Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "publish:data": "ts-node --transpile-only scripts/publishMarketData.ts",
    "publish:data:loop": "ts-node --transpile-only scripts/publishMarketData.ts --loop",
    "publish:data:dry": "ts-node --transpile-only scripts/publishMarketData.ts --dry",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "socket.io": "^4.8.3",
    "winston": "^3.13.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.2",
    "prisma": "^5.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
