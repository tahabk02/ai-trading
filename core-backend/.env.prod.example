# =============================================================================
#  core-backend — PRODUCTION ENVIRONMENT FILE
# =============================================================================
#  Copy to `.env.prod` (git-ignored) and fill in:
#     cp core-backend/.env.prod.example core-backend/.env.prod
#
#  Wired into docker-compose.prod.yml as
#     env_file: [ {path: ./core-backend/.env.prod, required: false} ]
#
#  ── HOW THIS RELATES TO THE `environment:` BLOCK IN COMPOSE ────────────────
#  Docker Compose gives `environment:` PRECEDENCE over `env_file`. The
#  compose file therefore declares the four critical values
#  (DATABASE_URL, REDIS_HOST, JWT_SECRET, CORS_ORIGIN) with `${VAR:?...}`
#  guards, which are resolved from the ROOT `.env` at parse time. This file
#  layers UNDER them and is the place for:
#    * anything not covered by the compose block, and
#    * a self-documenting record of the service's full configuration.
#  Keeping the critical four in both places is deliberate: a reader of this
#  file sees the complete contract, and an operator who sets only the root
#  `.env` still gets a correctly configured container.
#
#  ⚠️  NEVER commit the real `.env.prod` — it is git-ignored for that reason.
# =============================================================================

# ── DATABASE ───────────────────────────────────────────────────────────────
# Overridden by the compose `environment:` block. Documented here for
# completeness. MUST be a postgresql:// URL in production — core-backend
# refuses to boot rather than silently falling back to a local SQLite file.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/trading_radar?schema=public&sslmode=disable

# ── REDIS ──────────────────────────────────────────────────────────────────
# Overridden by the compose `environment:` block. Use the compose SERVICE NAME,
# never 127.0.0.1: inside a container, loopback is the container itself.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AUTH ───────────────────────────────────────────────────────────────────
# Overridden by the compose `environment:` block. REQUIRED: core-backend
# refuses to boot when this is unset, a known placeholder, or < 32 chars.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Service-to-service key shared with ai-engine. Must match its AI_ENGINE_API_KEY.
#   openssl rand -base64 48
AI_ENGINE_API_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────
# Overridden by the compose `environment:` block. MUST be the real public
# origin — NEVER `*`. The browser is same-origin behind the reverse proxy, and
# `Access-Control-Allow-Origin: *` is illegal alongside `credentials: true`.
# Multiple origins may be comma-separated.
CORS_ORIGIN=https://trade.example.com

# ── UPSTREAMS ──────────────────────────────────────────────────────────────
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_TIMEOUT_MS=120000
AI_ENGINE_MAX_RETRIES=3
POCKET_BRIDGE_HOST=pocket-bridge
POCKET_BRIDGE_PORT=8788
POCKET_BRIDGE_RECONNECT_MS=5000
# Never auto-spawn the Python bridge inside the backend container: it is a
# separate service. Leaving this on would fork a second, unmanaged bridge.
POCKET_BRIDGE_AUTO_SPAWN=false

# ── RATE LIMITING ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── MARKET DATA ────────────────────────────────────────────────────────────
# NO hardcoded fallbacks exist in the code any more. Empty means "this price
# tier is unavailable", which the feed degrades from honestly.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=
ALPACA_USE_SANDBOX=true
ALPACA_BASE_URL=https://data.sandbox.alpaca.markets
ALPACA_WS_ENDPOINT=wss://stream.data.sandbox.alpaca.markets/v2/sip
TWELVE_DATA_API_KEY=

# ── SPOT-RATE FALLBACK TIMINGS ────────────────────────────────────────────
FOREX_HTTP_TIMEOUT_MS=5000
FOREX_FALLBACK_TIMEOUT_MS=2000
FOREX_SOURCE_COOLDOWN_FAILURES=3
FOREX_SOURCE_COOLDOWN_MS=15000
FOREX_CHAIN_AUDIT_LOG_INTERVAL_MS=30000
