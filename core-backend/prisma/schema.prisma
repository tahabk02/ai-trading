generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Live trading signals streamed via WebSocket ──
model Signal {
  id         String   @id @default(uuid())
  symbol     String
  signalType String   // BUY, SELL
  price      Float
  confidence Float
  status     String   @default("ACTIVE") // ACTIVE, EXECUTED, CANCELLED
  indicators String   // JSON stored as string for SQLite compatibility
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outcomes  SignalOutcome[]

  @@index([symbol])
  @@index([createdAt])
}

// ── Real closed-trade outcomes of dispatched signals (PART 5 accuracy) ──
// One row per genuine settled signal. Ingestion is the single accuracy path:
// the live execution layer posts WIN/LOSS outcomes here, and the AI Engine's
// rolling accuracy tracker consumes them. ZERO fabrication — a row only exists
// when a real signal was filled and its outcome actually realized.
model SignalOutcome {
  id         String    @id @default(uuid())
  signalId   String?
  signal     Signal?   @relation(fields: [signalId], references: [id], onDelete: SetNull)
  symbol     String
  direction  String?   // BUY, SELL (the signal-time snapshot)
  confidence Float?    // signal-time confidence (0-100)
  tier       String    @default("T5") // T1 PREMIUM … T5 WEAK (signal-time tier)
  outcome    String    // WIN | LOSS — REAL realized outcome
  quality    Float?    // five-factor ensemble quality at signal time (0..1)
  factors    String?   // JSON snapshot of the signal-time factor ensemble
  entry      Float?    // real entry price
  exitPrice  Float?    // real exit price
  pnl        Float?    // realized signed P&L when reported
  timeframe  String?   // the signal's timeframe where known
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([symbol])
  @@index([outcome])
  @@index([tier])
  @@index([signalId])
  @@index([createdAt])
}

// ── AI prediction results (persistent record of every ML forecast) ──
model Prediction {
  id          String   @id @default(uuid())
  symbol      String
  signal      String   // BUY, SELL, HOLD
  confidence  Float
  targetPrice Float
  currentPrice Float?
  mlProbability Float?
  modelAccuracy Float?
  rsi14       Float?
  sma20       Float?
  sma50       Float?
  timeframe   String   @default("1d")
  metadata    String?  // JSON blob for extensible fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([symbol])
  @@index([createdAt])
  @@index([signal])
}

// ── Platform users ──
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

// ── User settings (persisted system configuration) ──
model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  timeframe           String   @default("1d")
  confidenceGuardrail Float    @default(0.80)
  maxRequestsPerMin   Int      @default(120)
  responseSlaMs       Int      @default(800)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@index([userId])
}

// ── Risk rules (persisted risk management parameters) ──
model RiskRule {
  id                String   @id @default(uuid())
  userId            String
  name              String   // e.g. "Max Drawdown", "Stop-Loss Threshold", "Position Size Limit"
  ruleType          String   // "max_drawdown" | "stop_loss" | "position_size" | "max_leverage"
  value             Float    // The numeric threshold
  enabled           Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([userId, ruleType])
}

// ── ADVANCED RISK MANAGEMENT & AUTOMATED KILL SWITCH ──
// Tracks the user's daily equity curve. When the realized daily drawdown
// breaches the configured max (e.g. 3%), the kill switch engages and locks
// ALL trade execution until manually reset or the next UTC trading day.
model RiskState {
  id                String    @id @default(uuid())
  userId            String    @unique
  dayKey            String    // UTC calendar day "YYYY-MM-DD" — auto-resets daily
  startingEquity    Float     @default(10000)
  realizedPnl       Float     @default(0) // signed cumulative $ P&L today
  peakEquity        Float     @default(10000) // intraday high-water mark
  tradesToday       Int       @default(0)
  winsToday         Int       @default(0)
  lossesToday       Int       @default(0)
  killSwitchLocked  Boolean   @default(false)
  lockedReason      String?
  lockedAt          DateTime?
  unlockedAt        DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@index([userId, dayKey])
}

// ── 30-MINUTE HISTORICAL DATA LAYER (Alpha.5 Pro, Part 3) ──
// Minute-bucketed OHLCV rollups + raw ticks persisted from the REAL observed
// live OTC tape. The background collector (historyCollector.service.ts) runs
// every 60s, buckets the authentic realtimeTickBuffer window into 1m bars and
// upserts them here — so the math-target / 98% precision gate always has a
// genuine 30-minute window per asset. ZERO fabricated bars: an entry only
// exists when real ticks were observed.

// One minute-bucketed OHLCV bar per (symbol, timeframe, bucket_start_ms).
model AssetHistory {
  id            String   @id @default(uuid())
  symbol        String
  timeframe     String   @default("1m")
  bucketStartMs BigInt   // epoch ms of the minute-bucket open (floor(ts/60000)*60000)
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Int?     // nullable: only real feed volume, else NULL (honest)
  tickCount     Int      @default(0) // REAL observed tick count inside the bucket
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([symbol, timeframe, bucketStartMs])
  @@index([symbol, timeframe, bucketStartMs])
  @@index([createdAt])
}

// Raw real-tick persistence for the 30-minute window (one row per genuine print).
model TickHistory {
  id        String   @id @default(uuid())
  symbol    String
  tsMs      BigInt   // epoch ms of the REAL tick
  price     Float
  volume    Int?     // nullable: only real feed volume, else NULL
  side      String?  // "BUY" | "SELL" when the feed reports a real side
  createdAt DateTime @default(now())

  @@unique([symbol, tsMs])
  @@index([symbol, tsMs])
  @@index([createdAt])
}
