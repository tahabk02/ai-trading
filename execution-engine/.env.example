# execution-engine — example configuration
#
# Copy to `execution-engine/.env` for local development. That file is
# gitignored; never commit real values.
#
# ── WHERE THIS FILE IS LOADED FROM ───────────────────────────────────────────
# `app/main.py` resolves this path from its own location
# (`<repo>/execution-engine/.env`), NOT from the process working directory.
# Launching the engine from the repo root therefore reads THIS file, not the
# root `.env`, and the same image behaves identically everywhere.
#
# Precedence, highest first:
#   1. real environment variable (docker compose / CI / systemd)
#   2. execution-engine/.env.local      (gitignored developer override)
#   3. execution-engine/.env.<ENVIRONMENT>   (only when it exists)
#   4. execution-engine/.env
#
# ── SECRETS ──────────────────────────────────────────────────────────────────
# Every value below is a PLACEHOLDER. `API_KEY` / `API_SECRET` / `REDIS_PASSWORD`
# are real exchange and infrastructure credentials: never commit a live value,
# never reuse one across environments, and rotate any key that has ever been
# written to a tracked file or shipped in an image. Inject them from your
# secret store in production.
#
# Nothing in this file needs to be a real value for `python -m app.main` to
# boot locally: the engine starts with `REQUIRE_CREDENTIALS=false` and refuses
# to place orders without credentials.

# ── Redis ───────────────────────────────────────────────────────────────────
# Required once Redis runs with `requirepass` (the hardened production stack
# does). Without it, every connect fails NOAUTH — which looks like a Redis
# outage rather than a configuration gap.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Full URL takes precedence over the parts above when set.
REDIS_URL=

# ── Exchange ────────────────────────────────────────────────────────────────
EXCHANGE_ID=binance
# Leave both EMPTY for local runs. The engine then reports "no credentials
# configured" instead of authenticating with a stale or fake key and surfacing
# an opaque exchange 401.
API_KEY=
API_SECRET=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Health/liveness port for the stdlib probe server.
HEALTH_PORT=8081
# Set true to refuse to boot without exchange credentials. Enabled by
# docker-compose.prod.yml so the engine can never place an order with a
# placeholder credential.
REQUIRE_CREDENTIALS=false
# Minimum signal confidence (0-1) the engine will act on.
MIN_CONFIDENCE=0.90
# Paper-trading starting balance.
DEFAULT_BALANCE=1000.0
