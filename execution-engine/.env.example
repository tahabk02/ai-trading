# execution-engine configuration
#
# Copy to execution-engine/.env for local development. Never commit real
# credentials. Environment variables injected by Docker Compose always win.
#
# Docker Compose (production): set EXCHANGE_API_KEY / EXCHANGE_API_SECRET in
# the repo-root .env. A direct `python -m app.main` run uses API_KEY /
# API_SECRET from this file. Compose deliberately overrides API_KEY, so filling
# it here alone will not enable live trading inside Compose.
#
# Precedence, highest first:
#   1. real environment variable (Docker Compose)
#   2. execution-engine/.env.local
#   3. execution-engine/.env.<ENVIRONMENT>
#   4. execution-engine/.env
#
# The repo-root .env is intentionally NOT read here; it configures the whole
# stack and has different units/keys (for example the AI confidence scale).

# ---------------------------------------------------------------------------
# SAFETY
# ---------------------------------------------------------------------------
# disabled = consume + audit signals, never place orders (default quarantine)
# paper    = simulated fills at the real signal price
# live     = real orders; requires credentials and an explicit symbol allowlist
TRADING_MODE=disabled

# Required for live only. The engine refuses to boot in live mode without them.
EXCHANGE_ID=binance
QUOTE_CURRENCY=USDT
API_KEY=
API_SECRET=
# Enable ONLY when the venue guarantees idempotent client order ids. Without
# that guarantee the gateway never re-submits an ambiguous order (it escalates
# to MANUAL_REVIEW instead) so a lost response cannot create a duplicate.
ASSUME_CLIENT_ORDER_IDEMPOTENCY=false

# A comma-separated allowlist. Empty denies every symbol. Wildcard "*" is
# allowed in paper/disabled mode only (live mode rejects it).
# Live mode also validates every symbol against EXCHANGE_ID at boot and exits
# if the venue does not list it (OTC forex pairs are not on Binance/ccxt spot).
# Example OTC universe:
# ALLOWED_SYMBOLS=EUR/USD,USD/JPY,USD/CHF,USD/CAD,AUD/USD,EUR/JPY,EUR/CHF,EUR/AUD,EUR/CAD,AUD/JPY,CAD/JPY,CHF/JPY,AUD/CAD,AUD/NZD,CAD/CHF,EUR/RUB,USD/TRY,USD/MXN,USD/SGD,MAD/USD,KES/USD
ALLOWED_SYMBOLS=

# Confidence contract is 0..100. A value below 1.0 is rejected as a unit error.
MIN_CONFIDENCE=96.5
MAX_SIGNAL_AGE_MS=5000

# ---------------------------------------------------------------------------
# RISK LIMITS
# ---------------------------------------------------------------------------
MAX_NOTIONAL_PER_TRADE=50
# 0 disables the aggregate open-notional cap.
MAX_OPEN_NOTIONAL=0
MAX_TRADES_PER_DAY=20
# 0 disables the daily loss circuit breaker (only where daily_pnl is known).
# Positive account-currency loss limit; 0 disables the daily-loss guard.
MAX_DAILY_LOSS=0
# Hard notional cap: min(MAX_NOTIONAL_PER_TRADE, equity * RISK_PER_TRADE).
# This is exposure sizing, not stop-distance risk sizing.
RISK_PER_TRADE=0.01
ALLOW_SHORT=true
DEDUPE_WINDOW_SECONDS=60

# Kill switch: either a Redis key equal to 1/true/on/yes, or a file whose
# contents are not 0/false/off/no. Checked before every order.
KILL_SWITCH_KEY=execution:kill_switch
KILL_SWITCH_FILE=

# ---------------------------------------------------------------------------
# SIGNAL TRANSPORT (Redis Streams, at-least-once)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=

SIGNAL_STREAM=trading_signals:stream
SIGNAL_GROUP=execution-gateway
# Leave empty to use execution-<pid>.
SIGNAL_CONSUMER=
SIGNAL_BATCH=32
SIGNAL_BLOCK_MS=5000
RECLAIM_MIN_IDLE_MS=30000
RECLAIM_COUNT=50
DEAD_LETTER_STREAM=execution:dead_letter

# ---------------------------------------------------------------------------
# STATE / RECONCILIATION
# ---------------------------------------------------------------------------
# SQLite is the durable idempotency + audit store. Mount /app/data in Docker.
SQLITE_PATH=data/execution.db
ORDER_POLL_INTERVAL_MS=2000
ORDER_POLL_TIMEOUT_MS=60000
MAX_SUBMIT_ATTEMPTS=3
# Pending INTENT/UNKNOWN orders older than this are expired, never retried.
MAX_RECONCILE_AGE_MS=60000

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081
LOG_LEVEL=INFO
DEFAULT_BALANCE=1000.0
