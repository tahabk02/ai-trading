# =============================================================================
# ALGORITHMIC TRADING PLATFORM — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to `.env` at the repository root and fill in your values.
#
#   cp .env.example .env
#
# All services (ai-engine, core-backend, execution-engine, client-app) read
# from this single root `.env` file via their respective settings layers
# (Pydantic, dotenv, next.config).  The docker-compose.yml also references
# these variables so that `docker compose up` works out of the box.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  CORE BACKEND  (Node.js / Express / Prisma / TypeScript)
#  Reads from: core-backend/src/config/secrets.ts
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express HTTP + WebSocket server listens on.
# The client-app expects this at http://localhost:4000 by default.
PORT=4000

# Environment label: "development" | "staging" | "production"
NODE_ENV=development

# Allowed CORS origin.  Use "*" during development; lock to your domain
# in production (e.g. https://trading.example.com).
CORS_ORIGIN=*

# Database connection string.
#   - SQLite (local dev):  file:./dev.db
#   - PostgreSQL (prod):   postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL=file:./dev.db

# JWT signing secret.  In production, generate a cryptographically random
# string at least 32 characters long.
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-chars!!

# JWT token expiration duration (e.g. "24h", "7d", "1h").
JWT_EXPIRES_IN=24h

# ─────────────────────────────────────────────────────────────────────────────
#  REDIS  (Message bus — used by all three back-end services)
#  Reads from: config/secrets.ts, ai-engine/app/core/config.py,
#              execution-engine/app/main.py
# ─────────────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternatively, a full connection URL (overrides HOST/PORT/PASSWORD):
# REDIS_URL=redis://:password@host:6379/0

# ─────────────────────────────────────────────────────────────────────────────
#  RATE LIMITING  (core-backend)
# ─────────────────────────────────────────────────────────────────────────────

# Sliding-window duration in milliseconds (default 60 000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests per window (default 120).
RATE_LIMIT_MAX=120

# ─────────────────────────────────────────────────────────────────────────────
#  AI ENGINE  (Python / FastAPI / scikit-learn / XGBoost)
#  Reads from: ai-engine/app/core/config.py
# ─────────────────────────────────────────────────────────────────────────────

# Confidence threshold for an ACTIVE signal (0.0 – 1.0).
# Signals below this value will be rejected at Layer 3.
CONFIDENCE_THRESHOLD=0.98

# Log output format: "CONSOLE" for human-readable, "JSON" for production / log aggregators.
LOG_FORMAT=CONSOLE

# Internal URL of the AI Engine (used by core-backend for proxy requests).
AI_ENGINE_URL=http://localhost:8001/api/v1

# Internal API key for service-to-service authentication between core-backend
# and ai-engine.  Must match what ai-engine/app/api/deps.py expects.
AI_ENGINE_API_KEY=INTERNAL_SECRET_AI_ENGINE

# Core Backend URL (used by ai-engine as an HTTP fallback when Redis is down).
BACKEND_API_URL=http://localhost:4000/api/v1

# ─────────────────────────────────────────────────────────────────────────────
#  EXECUTION ENGINE  (Python / Binance / Alpaca)
#  Reads from: execution-engine/app/main.py
# ─────────────────────────────────────────────────────────────────────────────

# Exchange identifier (e.g. "binance", "coinbase", "alpaca").
EXCHANGE_ID=binance

# Exchange API credentials (used by execution-engine/app/broker/binance_client.py).
API_KEY=YOUR_BINANCE_API_KEY
API_SECRET=YOUR_BINANCE_API_SECRET

# Minimum confidence required for automated trade execution (0.0 – 1.0).
# Only signals with confidence >= this value will trigger a live order.
MIN_CONFIDENCE=0.90

# Default simulated account balance for position sizing calculations.
DEFAULT_BALANCE=1000.0

# ─────────────────────────────────────────────────────────────────────────────
#  EXECUTION ENGINE — ALPACA BROKER  (US equities / paper trading)
#  Reads from: execution-engine/app/broker/alpaca_client.py
# ─────────────────────────────────────────────────────────────────────────────

# Alpaca API credentials.  Sign up at https://alpaca.markets
APCA_API_KEY_ID=your_alpaca_api_key_here
APCA_API_SECRET_KEY=your_alpaca_api_secret_here

# Set to "true" to use the Alpaca paper-trading environment (recommended for
# testing).  Set to "false" to trade with a live brokerage account.
APCA_PAPER=true

# ─────────────────────────────────────────────────────────────────────────────
#  ALPACA MARKET DATA — LIVE WEBSOCKET & REST API
#  Reads from: core-backend/src/services/alpacaMarketData.service.ts
#              core-backend/src/config/secrets.ts
#
#  Provides REAL-TIME live streaming + historical OHLCV bars from Alpaca's
#  institutional-grade SIP data feed. Applied to crypto symbols (BTC/USD,
#  ETH/USD) and any US stocks/ETFs. Forex OTC pairs fall back to existing
#  real-rate APIs (er-api, frankfurter).
# ─────────────────────────────────────────────────────────────────────────────

# Alpaca REST Data API base URL
# Live:  https://data.alpaca.markets
# Sandbox: https://data.sandbox.alpaca.markets
ALPACA_BASE_URL=https://data.alpaca.markets

# Alpaca WebSocket data stream endpoint (real-time trades + quotes)
# Live:  wss://stream.data.alpaca.markets/v2/sip
# Sandbox: wss://stream.data.sandbox.alpaca.markets/v2/sip
ALPACA_WS_ENDPOINT=wss://stream.data.alpaca.markets/v2/sip

# Set to "true" to use Alpaca's sandbox data feed (no real money, simulated data)
ALPACA_USE_SANDBOX=false

# ─────────────────────────────────────────────────────────────────────────────
#  CLIENT APP  (Next.js 14 / React / Tailwind CSS)
#  Reads from: process.env.NEXT_PUBLIC_* at runtime
#              client-app/next.config.js
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Core Backend API for all REST calls.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# WebSocket URL for the real-time signal stream (Socket.IO).
NEXT_PUBLIC_WS_URL=http://localhost:4000

# URL of the AI Engine (used as a secondary prediction source).
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8001/api/v1

# ─────────────────────────────────────────────────────────────────────────────
#  POCKET OPTION LIVE BRIDGE  (Python pocket-bridge service)
#  Reads from: core-backend/src/config/secrets.ts, pocket-bridge/
#
#  The Python bridge connects to Pocket Option with the SSID below and relays
#  live ticks + strict M20 (20-second) candles to the backend over a local
#  WebSocket (SSOT for real prices). It NEVER fabricates prices. Leave
#  POCKET_OPTION_SSID empty to run everything in a clean "awaiting_ssid"
#  state with no live data.
# ─────────────────────────────────────────────────────────────────────────────

# Full Pocket Option session cookie (the entire `42["auth",{...}]` payload that
# BinaryOptionsToolsV2 requires). Grab it from your logged-in browser:
#   DevTools -> Application -> Cookies -> https://pocketoption.com -> ssid
POCKET_OPTION_SSID=

# Local relay host/port the backend connects to as a WebSocket client.
POCKET_BRIDGE_HOST=127.0.0.1
POCKET_BRIDGE_PORT=8788

# Backend reconnect interval (ms) when the relay is down.
POCKET_BRIDGE_RECONNECT_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
#  POSTGRES / DOCKER COMPOSE  (used by docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL superuser credentials (only used inside Docker Compose).
DB_USER=postgres
DB_PASSWORD=password

# ─────────────────────────────────────────────────────────────────────────────
#  MARKET DATA PUBLISHER  (core-backend/scripts/publishMarketData.ts)
#
#  Publishes real live prices to a GitHub repo raw file that ForexDataService
#  polls (data/fx_spot.json by default). Configure the destination repo + a
#  GitHub Personal Access Token (needs Contents: read/write on that repo).
#  Run:  npm run publish:data        (single publish)
#        npm run publish:data:loop   (continuous loop)
#        npm run publish:data:dry    (print payload without publishing)
# ─────────────────────────────────────────────────────────────────────────────

# GitHub PAT with Contents: read/write on the destination repo.
GITHUB_TOKEN=

# Destination repo owner/name + branch. These MUST match the values
# ForexDataService reads (FOREX_GITHUB_REPO_OWNER / _NAME / GITHUB_DATA_BRANCH).
FOREX_GITHUB_REPO_OWNER=your-github-username
FOREX_GITHUB_REPO_NAME=your-market-data-repo
GITHUB_DATA_BRANCH=main

# File path in the repo (must match FOREX_GITHUB_PRICES_FILE in the backend).
FOREX_GITHUB_PRICES_FILE=data/fx_spot.json

# How often the publisher pushes a new snapshot (ms).
FOREX_GITHUB_POLL_MS=10000
# How often the publisher re-fetches upstream prices (ms).
FOREX_PUBLISH_REFRESH_MS=60000
